{
  "manifest_version": 3,
  "name": "Blank Mode",
  "version": "0.2.4",
  "description": "Hide recommendation feeds and turn YouTube into a search-first experience.",

  "permissions": [
    "storage",
    "tabs",
    "activeTab"
  ],

  "host_permissions": [
    "https://www.youtube.com/*"
  ],

  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Blank Mode"
  },

  "background": {
    "service_worker": "background/background.js"
  },

  "commands": {
    "toggle-blank-mode": {
      "suggested_key": {
        "default": "Alt+Shift+Y",
        "mac": "Alt+Shift+Y"
      },
      "description": "Toggle Blank Mode on/off"
    }
  },

  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["content/youtube.js"],
      "css": ["styles/youtube.css"],
      "run_at": "document_idle"
    }
  ],

  "icons": {}
}
